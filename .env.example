# Copy this file to .env for running on your own computer.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# PostgreSQL (Render > your database > Connect > External Database URL, plus ?sslmode=require)
DATABASE_URL=postgres://demo:demo@127.0.0.1:5432/demo

# Any long random string. Keep it secret; changing it signs everyone out.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The public address of the site, used in email links. Leave empty on Vercel until you add your own domain.
SITE_URL=http://localhost:3000

# Email (optional). Without these, emails are only printed in the server log.
# Resend:   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>  EMAIL_FROM=onboarding@resend.dev
# Postmark: SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587  SMTP_USER=<server token>  SMTP_PASS=<server token>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Meilisearch (optional). Without these, search uses the database.
MEILI_HOST=
MEILI_API_KEY=
